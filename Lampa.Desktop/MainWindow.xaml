<Window x:Class="Lampa.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lampa Desktop"
        Width="460"
        Height="820"
        MinWidth="420"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        FontFamily="Consolas"
        TextOptions.TextFormattingMode="Display"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Closing="Window_Closing">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0"
                  GlassFrameThickness="0"
                  ResizeBorderThickness="6"
                  CornerRadius="16"
                  UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <LinearGradientBrush x:Key="CosmicBackground" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#03080E" Offset="0" />
      <GradientStop Color="#07111D" Offset="0.52" />
      <GradientStop Color="#020509" Offset="1" />
    </LinearGradientBrush>

    <Style x:Key="GlassCard" TargetType="Border">
      <Setter Property="Background" Value="#D90B1422" />
      <Setter Property="BorderBrush" Value="#804477A7" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="2" />
    </Style>

    <Style x:Key="MenuRowButton" TargetType="Button">
      <Setter Property="Background" Value="#D90B1422" />
      <Setter Property="Foreground" Value="#A9D9FF" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="Height" Value="56" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="#804477A7" BorderThickness="1" CornerRadius="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#E012253A" />
                <Setter TargetName="Root" Property="BorderBrush" Value="#FF58B8FF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ModeToggleButton" TargetType="Button">
      <Setter Property="MinWidth" Value="78" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#80FFFFFF" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root"
                    Background="{TemplateBinding Background}"
                    CornerRadius="16"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                TextBlock.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Tag" Value="active">
                <Setter TargetName="Root" Property="Background" Value="#262DF578" />
                <Setter Property="Foreground" Value="#42F58A" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="RoundIconButton" TargetType="Button">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#FF9D1C" />
      <Setter Property="FontSize" Value="20" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="20">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                TextBlock.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#263E91D0" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="TitleBarButton" TargetType="Button">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#9CCEF5" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="10">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#1FFFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PlusImportButton" TargetType="Button">
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="12,0,14,0" />
      <Setter Property="Background" Value="#1A1010" />
      <Setter Property="Foreground" Value="#FF9D1C" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root"
                    Background="{TemplateBinding Background}"
                    BorderBrush="#FF9D1C"
                    BorderThickness="1"
                    CornerRadius="1"
                    Padding="{TemplateBinding Padding}">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path Width="11"
                      Height="11"
                      Stretch="Uniform"
                      Fill="{TemplateBinding Foreground}"
                      Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"
                      VerticalAlignment="Center" />
                <TextBlock Text="Добавить"
                           Margin="8,0,0,0"
                           Foreground="{TemplateBinding Foreground}"
                           FontSize="{TemplateBinding FontSize}"
                           FontWeight="{TemplateBinding FontWeight}"
                           VerticalAlignment="Center" />
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#332414" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#4A2C0B" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="GoldSlider" TargetType="Slider">
      <Setter Property="Minimum" Value="0" />
      <Setter Property="IsSnapToTickEnabled" Value="True" />
      <Setter Property="IsMoveToPointEnabled" Value="True" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid VerticalAlignment="Center">
              <Border Height="4" Background="#22FFFFFF" CornerRadius="2" Margin="8,0" />
              <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="Slider.DecreaseLarge" IsTabStop="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" Background="#FF9D1C" CornerRadius="0" Margin="8,0,0,0" />
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Width="18" Height="18">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Ellipse Fill="#FF9D1C" />
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="Slider.IncreaseLarge" IsTabStop="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SettingsCard" TargetType="Border">
      <Setter Property="Background" Value="#E00B1422" />
      <Setter Property="BorderBrush" Value="#804477A7" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#E0060D16" />
      <Setter Property="Foreground" Value="#CBE8FF" />
      <Setter Property="BorderBrush" Value="#8058B8FF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="Height" Value="40" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="CaretBrush" Value="#42F58A" />
    </Style>
    <Style x:Key="RuleAddButton" TargetType="Button">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="Background" Value="#14281E" />
      <Setter Property="Foreground" Value="#42F58A" />
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="#42F58A" BorderThickness="1" CornerRadius="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="InfoChipButton" TargetType="Button">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontStyle" Value="Italic" />
      <Setter Property="Foreground" Value="#58B8FF" />
      <Setter Property="Background" Value="#223E91D0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="11">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#44FFB300" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="GoldProgress" TargetType="ProgressBar">
      <Setter Property="Height" Value="3" />
      <Setter Property="Foreground" Value="#42F58A" />
      <Setter Property="Background" Value="#223E91D0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2" Height="{TemplateBinding Height}">
              <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="2" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="GhostButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#FF8A80" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="White" />
    </Style>

    <Storyboard x:Key="PowerPulseStoryboard" RepeatBehavior="Forever">
      <DoubleAnimation Storyboard.TargetName="PowerScale"
                       Storyboard.TargetProperty="ScaleX"
                       From="1" To="1.035" Duration="0:0:0.75"
                       AutoReverse="True" />
      <DoubleAnimation Storyboard.TargetName="PowerScale"
                       Storyboard.TargetProperty="ScaleY"
                       From="1" To="1.035" Duration="0:0:0.75"
                       AutoReverse="True" />
      <DoubleAnimation Storyboard.TargetName="PowerButton"
                       Storyboard.TargetProperty="Opacity"
                       From="1" To="0.78" Duration="0:0:0.75"
                       AutoReverse="True" />
    </Storyboard>
    <Storyboard x:Key="PowerConnectedStoryboard">
      <DoubleAnimation Storyboard.TargetName="PowerScale"
                       Storyboard.TargetProperty="ScaleX"
                       From="0.94" To="1.08" Duration="0:0:0.28"
                       AutoReverse="True" />
      <DoubleAnimation Storyboard.TargetName="PowerScale"
                       Storyboard.TargetProperty="ScaleY"
                       From="0.94" To="1.08" Duration="0:0:0.28"
                       AutoReverse="True" />
      <DoubleAnimation Storyboard.TargetName="PowerButton"
                       Storyboard.TargetProperty="Opacity"
                       From="0.62" To="1" Duration="0:0:0.28" />
    </Storyboard>
  </Window.Resources>

  <Border Background="{StaticResource CosmicBackground}"
          CornerRadius="2"
          BorderBrush="#8058B8FF"
          BorderThickness="1"
          ClipToBounds="True">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="52" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#F0040A11" BorderBrush="#604477A7" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
      <Grid Margin="12,8,12,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="pack://application:,,,/Assets/hottabych-genie-v2.png" Width="30" Height="30" Stretch="Uniform" />
          <TextBlock Text="::{ХОТТ@БЫ}Ч // DESKTOP::" Foreground="#42F58A" FontSize="14" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <Button Grid.Column="1"
                Style="{StaticResource TitleBarButton}"
                Content="⚙"
                ToolTip="Настройки"
                Click="SettingsNav_Click"
                FontSize="16"
                Margin="0,0,4,0" />
        <Button Grid.Column="2" Style="{StaticResource TitleBarButton}" Content="—" Click="Minimize_Click" />
        <Button Grid.Column="3" Style="{StaticResource TitleBarButton}" Content="▢" Click="MaximizeRestore_Click" Margin="8,0,0,0" />
        <Button Grid.Column="4" Style="{StaticResource TitleBarButton}" Content="✕" Click="Close_Click" Margin="8,0,0,0" />
      </Grid>
    </Border>

    <Border Grid.Row="1"
            x:Name="UpdateBanner"
            Visibility="Collapsed"
            Background="#1A140E"
            BorderBrush="#22FFB300"
            BorderThickness="0,0,0,1"
            Padding="14,8"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="UpdateBannerText"
                     Text="Скачиваем обновление…"
                     Foreground="#E6F4E6"
                     FontSize="12"
                     TextTrimming="CharacterEllipsis" />
          <ProgressBar x:Name="UpdateProgressBar"
                       Style="{StaticResource GoldProgress}"
                       Minimum="0"
                       Maximum="100"
                       Value="0"
                       Margin="0,6,0,0"
                       Visibility="Collapsed" />
        </StackPanel>
        <Button Grid.Column="1"
                x:Name="UpdateInstallBtn"
                Content="Обновить"
                Click="InstallUpdate_Click"
                Visibility="Collapsed"
                Margin="12,0,0,0"
                Padding="12,6"
                Background="#FFB300"
                Foreground="#1A0F08"
                FontWeight="SemiBold"
                FontSize="12"
                BorderThickness="0" />
      </Grid>
    </Border>

    <!-- Home -->
    <ScrollViewer Grid.Row="2" x:Name="HomePage" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Padding="24,20,24,24">
      <StackPanel MaxWidth="400">
        <TextBlock Text=":: ВРЕМЯ СЕАНСА ::" Foreground="#668EB5D2" FontSize="12" HorizontalAlignment="Center" />
        <TextBlock x:Name="ConnectionTimerText"
                   Text="00:00:00"
                   Foreground="#CBE8FF"
                   FontSize="40"
                   FontWeight="Light"
                   HorizontalAlignment="Center"
                   Margin="0,4,0,20" />

        <Button x:Name="PowerButton"
                Width="148"
                Height="148"
                HorizontalAlignment="Center"
                Click="PowerButton_Click"
                Background="#E0091320"
                BorderBrush="#B058B8FF"
                BorderThickness="3"
                Foreground="#42F58A"
                Margin="0,0,0,12"
                Cursor="Hand"
                ToolTip="Подключить"
                RenderTransformOrigin="0.5,0.5">
          <Button.RenderTransform>
            <ScaleTransform x:Name="PowerScale" ScaleX="1" ScaleY="1" />
          </Button.RenderTransform>
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Grid>
                <Ellipse x:Name="PowerGlow"
                         Width="168"
                         Height="168"
                         Fill="#4058B8FF"
                         Opacity="0"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
                <Border x:Name="Shell"
                        Width="140"
                        Height="140"
                        CornerRadius="70"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                  <Viewbox Width="52" Height="52">
                    <Grid Width="24" Height="24">
                      <Path Data="M12,2.6 L12,10.4"
                            Stroke="{TemplateBinding Foreground}"
                            StrokeThickness="2.5"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round" />
                      <Path Data="M7.05,5.7 A7.3,7.3 0 1 0 16.95,5.7"
                            Stroke="{TemplateBinding Foreground}"
                            StrokeThickness="2.5"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            Fill="Transparent" />
                    </Grid>
                  </Viewbox>
                </Border>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="PowerGlow" Property="Opacity" Value="0.28" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Shell" Property="Opacity" Value="0.92" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
        </Button>

        <Border HorizontalAlignment="Center"
                Background="#40101C2A"
                BorderBrush="#604477A7"
                BorderThickness="1"
                CornerRadius="1"
                Padding="16,6"
                Margin="0,0,0,6">
          <TextBlock x:Name="StatusBadgeText" Text="НЕ В СЕТИ" Foreground="#8EB5D2" FontSize="12" />
        </Border>
        <TextBlock x:Name="SelectedProfileText"
                   Text="Конфигурация не выбрана"
                   Foreground="#CBE8FF"
                   FontSize="16"
                   FontWeight="SemiBold"
                   TextAlignment="Center"
                   Margin="0,8,0,18" />

        <Border Style="{StaticResource GlassCard}" Padding="14,12" Margin="0,0,0,10" Visibility="Collapsed">
          <DockPanel LastChildFill="True">
            <Border DockPanel.Dock="Right" Background="#B0060D16" BorderBrush="#604477A7" BorderThickness="1" CornerRadius="1" Padding="3" Margin="10,0,0,0">
              <StackPanel Orientation="Horizontal">
                <Button x:Name="FullRoutingBtn" Style="{StaticResource ModeToggleButton}" Content="Полная" Click="FullRouting_Click" />
                <Button x:Name="FastRoutingBtn" Style="{StaticResource ModeToggleButton}" Content="Быстрая" Click="FastRouting_Click" />
              </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="Маршрутизация" Foreground="White" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <Button x:Name="RoutingInfoBtn"
                      Style="{StaticResource InfoChipButton}"
                      Content="i"
                      Click="RoutingInfo_Click"
                      Margin="8,0,0,0"
                      ToolTip="Чем отличаются режимы" />
            </StackPanel>
          </DockPanel>
        </Border>
        <Popup x:Name="RoutingInfoPopup"
               PlacementTarget="{Binding ElementName=RoutingInfoBtn}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               HorizontalOffset="-8"
               VerticalOffset="8">
          <Border Background="#F0060D16"
                  CornerRadius="2"
                  Padding="16"
                  BorderBrush="#8058B8FF"
                  BorderThickness="1"
                  Width="320">
            <StackPanel>
              <TextBlock Text="Полная" Foreground="#FFB300" FontWeight="SemiBold" FontSize="14" />
              <TextBlock Text="P0–P4: блокировки и сайты с ограничением для РФ через VPN, остальное напрямую. P5+: белые списки."
                         Foreground="#CCFFF4E6"
                         FontSize="12"
                         TextWrapping="Wrap"
                         Margin="0,4,0,12" />
              <TextBlock Text="Быстрая" Foreground="#FFB300" FontWeight="SemiBold" FontSize="14" />
              <TextBlock Text="Прежняя схема RoscomVPN: российские ресурсы напрямую, остальной интернет согласно выбранной политике."
                         Foreground="#CCFFF4E6"
                         FontSize="12"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </Popup>

        <Border Style="{StaticResource GlassCard}" Padding="14,12" Margin="0,0,0,10">
          <DockPanel LastChildFill="True">
            <Border DockPanel.Dock="Right" Background="#B0060D16" CornerRadius="1" Padding="3" Margin="10,0,0,0">
              <StackPanel Orientation="Horizontal">
                <Button x:Name="ProxyModeBtn" Style="{StaticResource ModeToggleButton}" Content="Прокси" Click="ProxyMode_Click" />
                <Button x:Name="TunModeBtn" Style="{StaticResource ModeToggleButton}" Tag="active" Content="Туннель" Click="TunMode_Click" />
              </StackPanel>
            </Border>
            <TextBlock Text=">> РЕЖИМ СЕТИ" Foreground="#9CCEF5" FontSize="13" VerticalAlignment="Center" />
          </DockPanel>
        </Border>

        <Button Style="{StaticResource MenuRowButton}" Click="ChooseBypassApps_Click" Margin="0,0,0,8">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="36" Height="36" CornerRadius="1" Background="#202DF578" BorderBrush="#42F58A" BorderThickness="1" Margin="0,0,12,0">
              <TextBlock Text="↯" Foreground="#42F58A" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text=">> РАЗД. ТУННЕЛЬ" Foreground="#58B8FF" TextDecorations="Underline" FontSize="14" />
              <TextBlock x:Name="BypassSummaryText" Text="Все приложения через VPN" Foreground="#99FFFFFF" FontSize="12" Margin="0,2,0,0" />
            </StackPanel>
            <TextBlock Grid.Column="2" Text="»" Foreground="#FF9D1C" FontSize="20" VerticalAlignment="Center" />
          </Grid>
        </Button>

        <Button Style="{StaticResource MenuRowButton}" Click="RulesNav_Click" Margin="0,0,0,18">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="36" Height="36" CornerRadius="1" Background="#202DF578" BorderBrush="#42F58A" BorderThickness="1" Margin="0,0,12,0">
              <TextBlock Text="≋" Foreground="#42F58A" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Grid.Column="1" Text=">> МОИ ПРАВИЛА" Foreground="#58B8FF" TextDecorations="Underline" FontSize="14" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="»" Foreground="#FF9D1C" FontSize="20" VerticalAlignment="Center" />
          </Grid>
        </Button>

        <TextBlock Text=":: ПОДПИСКА ::" Foreground="#FF9D1C" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />

        <Border x:Name="SubscriptionCard" Style="{StaticResource GlassCard}" Padding="16">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                <TextBlock x:Name="SubscriptionNameText"
                           Text="Подписка не добавлена"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SubscriptionMetaText"
                           Text="Добавьте ссылку кнопкой справа"
                           Foreground="#8FFFFFFF"
                           FontSize="11"
                           Margin="0,3,0,0"
                           TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Grid>
                  <Button x:Name="AddSubscriptionBtn"
                          Style="{StaticResource PlusImportButton}"
                          ToolTip="Добавить подписку"
                          Click="ToggleImportPopup_Click" />
                  <Popup x:Name="ImportPopup"
                         PlacementTarget="{Binding ElementName=AddSubscriptionBtn}"
                         Placement="Bottom"
                         StaysOpen="False"
                         AllowsTransparency="True"
                         HorizontalOffset="-210"
                         VerticalOffset="8">
                    <Border Background="#F0060D16"
                            CornerRadius="2"
                            Padding="10"
                            BorderBrush="#8058B8FF"
                            BorderThickness="1"
                            Width="260">
                      <StackPanel>
                        <Button Content="Из буфера обмена"
                                Click="ImportFromClipboard_Click"
                                HorizontalContentAlignment="Left"
                                Padding="14,12"
                                Background="#E00B1422"
                                Foreground="#CBE8FF"
                                Margin="0,0,0,6" />
                        <Button Content="Ввести ссылку вручную"
                                Click="ShowManualImport_Click"
                                HorizontalContentAlignment="Left"
                                Padding="14,12"
                                Background="#E00B1422"
                                Foreground="#CBE8FF" />
                        <StackPanel x:Name="ManualImportPanel" Visibility="Collapsed" Margin="0,8,0,0">
                          <TextBox x:Name="HomeSubscriptionUrlBox" Height="40" Margin="0,0,0,8" />
                          <Button Content="Сохранить ссылку"
                                  Click="ImportManualUrl_Click"
                                  Padding="14,10"
                                  Background="#FFB300"
                                  Foreground="#1A0F08"
                                  FontWeight="SemiBold" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </Popup>
                </Grid>
                <Button Style="{StaticResource RoundIconButton}"
                        Content="↻"
                        FontSize="18"
                        ToolTip="Обновить подписку"
                        Click="Refresh_Click"
                        Margin="4,0,0,0" />
              </StackPanel>
            </Grid>
            <TextBlock x:Name="SelectedServerText"
                       Text=""
                       Foreground="#C9FFFFFF"
                       FontSize="13"
                       Margin="0,10,0,0"
                       TextTrimming="CharacterEllipsis" />
            <Button x:Name="ToggleLinkBtn"
                    Content="Показать ссылку"
                    Click="ToggleSubscriptionLink_Click"
                    HorizontalAlignment="Left"
                    Padding="0"
                    Margin="0,10,0,0"
                    Background="Transparent"
                    Foreground="#FFD180"
                    FontSize="12" />
            <TextBlock x:Name="SubscriptionLinkText"
                       Text=""
                       Foreground="#80FFFFFF"
                       FontSize="11"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />
            <ListBox x:Name="ProfilesList"
                     Background="Transparent"
                     BorderThickness="0"
                     Margin="0,10,0,0"
                     Visibility="Collapsed"
                     SelectionChanged="ProfilesList_SelectionChanged">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Padding="10,8" CornerRadius="12" Background="#18120C" Margin="0,0,0,6">
                    <TextBlock Text="{Binding Name}" Foreground="White" FontSize="13" />
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </Border>

        <TextBlock x:Name="StatusHint"
                   Text=""
                   Visibility="Collapsed"
                   Foreground="#66FFFFFF"
                   FontSize="12"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Margin="8,14,8,0" />
      </StackPanel>
    </ScrollViewer>

    <!-- Routing overlay -->
    <Grid Grid.Row="2" x:Name="RoutingPage" Visibility="Collapsed" Background="{StaticResource CosmicBackground}">
      <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Padding="24,20,24,24">
        <StackPanel MaxWidth="400">
          <DockPanel Margin="0,0,0,18">
            <Button DockPanel.Dock="Left"
                    Content="←"
                    Click="HomeNav_Click"
                    Width="36"
                    Height="36"
                    Background="Transparent"
                    Foreground="White"
                    FontSize="20" />
            <TextBlock Text="Маршрутизация" Foreground="White" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0" />
          </DockPanel>

          <Border Style="{StaticResource SettingsCard}" Padding="14,12">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="ⓘ" Foreground="#99FFFFFF" Margin="0,0,10,0" />
              <TextBlock Text="Маршрутизация приложений не работает в режиме прокси"
                         Foreground="#99FFFFFF"
                         FontSize="13"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource SettingsCard}">
            <StackPanel>
              <TextBlock x:Name="BypassAppsText"
                         Text="Приложения не выбраны"
                         Foreground="White"
                         TextWrapping="Wrap"
                         Margin="0,0,0,12" />
              <StackPanel Orientation="Horizontal">
                <Button Content="Выбрать приложения"
                        Click="ChooseBypassApps_Click"
                        Padding="14,8"
                        Background="#33FFB300"
                        Foreground="#1A0F08"
                        FontWeight="SemiBold" />
                <Button Content="Очистить"
                        Click="ClearBypassApps_Click"
                        Margin="8,0,0,0"
                        Padding="14,8"
                        Background="Transparent"
                        Foreground="#FF8A80" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- Rules overlay -->
    <Grid Grid.Row="2" x:Name="RulesPage" Visibility="Collapsed" Background="{StaticResource CosmicBackground}">
      <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Padding="24,20,24,24">
        <StackPanel MaxWidth="400">
          <DockPanel Margin="0,0,0,18">
            <Button DockPanel.Dock="Left"
                    Content="←"
                    Click="HomeNav_Click"
                    Width="36"
                    Height="36"
                    Background="Transparent"
                    Foreground="White"
                    FontSize="20" />
            <TextBlock Text="Мои правила" Foreground="White" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0" />
          </DockPanel>

          <Border Style="{StaticResource SettingsCard}" Padding="16">
            <StackPanel>
              <Grid Margin="0,0,0,10">
                <TextBlock Text="Через VPN" Foreground="White" FontSize="15" FontWeight="SemiBold" />
                <TextBlock x:Name="CustomProxyCountText" Text="0" HorizontalAlignment="Right" Foreground="#80FFFFFF" FontSize="12" VerticalAlignment="Center" />
              </Grid>
              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Background="#221A1208" CornerRadius="12" BorderBrush="#44FFB300" BorderThickness="1">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="https://" Foreground="#80FFFFFF" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
                    <TextBox x:Name="CustomProxyHostBox"
                             Height="40"
                             Background="Transparent"
                             BorderThickness="0"
                             VerticalContentAlignment="Center"
                             Padding="8,0,12,0"
                             KeyDown="CustomProxyHostBox_KeyDown" />
                  </DockPanel>
                </Border>
                <Button Grid.Column="1"
                        Style="{StaticResource RuleAddButton}"
                        Content="+"
                        Width="44"
                        FontSize="22"
                        FontWeight="Light"
                        Margin="8,0,0,0"
                        Click="AddCustomProxy_Click" />
              </Grid>
              <ItemsControl x:Name="CustomProxyRulesList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="#22180F" CornerRadius="12" Padding="12,8" Margin="0,0,0,6">
                      <Grid>
                        <TextBlock Text="{Binding}" Foreground="White" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,36,0" />
                        <Button Content="✕"
                                Width="28"
                                Height="28"
                                HorizontalAlignment="Right"
                                Background="Transparent"
                                Foreground="#FF8A80"
                                FontSize="12"
                                Tag="{Binding}"
                                Click="RemoveProxyRule_Click" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock x:Name="CustomProxyEmptyText"
                         Text="Пока пусто — сайт пойдёт через VPN"
                         Foreground="#55FFFFFF"
                         FontSize="12"
                         Margin="0,2,0,0" />
              <Button x:Name="ClearCustomProxyBtn"
                      Content="Очистить все"
                      Click="ClearCustomProxy_Click"
                      HorizontalAlignment="Left"
                      Background="Transparent"
                      Foreground="#FF8A80"
                      FontSize="12"
                      Padding="0"
                      Margin="0,8,0,0"
                      Visibility="Collapsed" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource SettingsCard}" Padding="16">
            <StackPanel>
              <Grid Margin="0,0,0,10">
                <TextBlock Text="Мимо VPN" Foreground="White" FontSize="15" FontWeight="SemiBold" />
                <TextBlock x:Name="CustomDirectCountText" Text="0" HorizontalAlignment="Right" Foreground="#80FFFFFF" FontSize="12" VerticalAlignment="Center" />
              </Grid>
              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Background="#221A1208" CornerRadius="12" BorderBrush="#44FFB300" BorderThickness="1">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="https://" Foreground="#80FFFFFF" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
                    <TextBox x:Name="CustomDirectHostBox"
                             Height="40"
                             Background="Transparent"
                             BorderThickness="0"
                             VerticalContentAlignment="Center"
                             Padding="8,0,12,0"
                             KeyDown="CustomDirectHostBox_KeyDown" />
                  </DockPanel>
                </Border>
                <Button Grid.Column="1"
                        Style="{StaticResource RuleAddButton}"
                        Content="+"
                        Width="44"
                        FontSize="22"
                        FontWeight="Light"
                        Margin="8,0,0,0"
                        Click="AddCustomDirect_Click" />
              </Grid>
              <ItemsControl x:Name="CustomDirectRulesList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="#22180F" CornerRadius="12" Padding="12,8" Margin="0,0,0,6">
                      <Grid>
                        <TextBlock Text="{Binding}" Foreground="White" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,36,0" />
                        <Button Content="✕"
                                Width="28"
                                Height="28"
                                HorizontalAlignment="Right"
                                Background="Transparent"
                                Foreground="#FF8A80"
                                FontSize="12"
                                Tag="{Binding}"
                                Click="RemoveDirectRule_Click" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock x:Name="CustomDirectEmptyText"
                         Text="Пока пусто — сайт пойдёт напрямую"
                         Foreground="#55FFFFFF"
                         FontSize="12"
                         Margin="0,2,0,0" />
              <Button x:Name="ClearCustomDirectBtn"
                      Content="Очистить все"
                      Click="ClearCustomDirect_Click"
                      HorizontalAlignment="Left"
                      Background="Transparent"
                      Foreground="#FF8A80"
                      FontSize="12"
                      Padding="0"
                      Margin="0,8,0,0"
                      Visibility="Collapsed" />
            </StackPanel>
          </Border>

          <Button x:Name="SaveCustomRulesBtn"
                  Content="Сохранить"
                  Click="SaveCustomRules_Click"
                  IsEnabled="False"
                  Opacity="0.4"
                  HorizontalAlignment="Stretch"
                  Padding="16,12"
                  Background="#FFB300"
                  Foreground="#1A0F08"
                  FontWeight="SemiBold"
                  Margin="0,8,0,0" />
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- Settings overlay -->
    <Grid Grid.Row="2" x:Name="SettingsPage" Visibility="Collapsed" Background="{StaticResource CosmicBackground}">
      <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Padding="24,20,24,24">
        <StackPanel MaxWidth="400">
          <DockPanel Margin="0,0,0,18">
            <Button DockPanel.Dock="Left"
                    Content="←"
                    Click="HomeNav_Click"
                    Width="36"
                    Height="36"
                    Background="Transparent"
                    Foreground="White"
                    FontSize="20" />
            <TextBlock Text="Настройки" Foreground="White" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0" />
          </DockPanel>

          <Border Style="{StaticResource SettingsCard}">
            <StackPanel>
              <TextBlock Text="Компонент подключения" Foreground="White" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6" />
              <TextBlock Text="Путь к ядру и локальный порт." Foreground="#99FFFFFF" FontSize="13" Margin="0,0,0,10" />
              <TextBox x:Name="CorePathBox" Height="40" Margin="0,0,0,10" />
              <TextBlock Text="Локальный порт" Foreground="#99FFFFFF" FontSize="12" Margin="0,0,0,6" />
              <TextBox x:Name="PortBox" Width="120" HorizontalAlignment="Left" Height="40" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource SettingsCard}">
            <StackPanel>
              <CheckBox x:Name="TunCheck" Content="TUN: весь трафик через VPN" IsChecked="True" Margin="0,2,0,10" Checked="TunCheck_Changed" Unchecked="TunCheck_Changed" />
              <CheckBox x:Name="PauseOnSleepCheck" Content="Отключать VPN во время сна" IsChecked="True" Margin="0,2,0,4"
                        Checked="PauseOnSleepCheck_Changed" Unchecked="PauseOnSleepCheck_Changed" />
              <TextBlock Text="Ядро замораживается, без разбора правил заново. После пробуждения поднимается сразу."
                         Foreground="#66FFFFFF" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" />
              <CheckBox x:Name="AutoReconnectCheck" Content="Восстанавливать после сна и смены сети" IsChecked="True" Margin="0,2,0,10" />
              <CheckBox x:Name="StartupCheck" Content="Запускать вместе с Windows" Margin="0,2,0,0" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource SettingsCard}" Visibility="Collapsed">
            <StackPanel>
              <TextBlock Text="Что пускать через VPN" Foreground="White" FontSize="15" FontWeight="SemiBold" />
              <TextBlock Text="На приоритетных серверах (FULL). Whitelist на резервных серверах не меняется."
                         Foreground="#99FFFFFF"
                         FontSize="12"
                         TextWrapping="Wrap"
                         Margin="0,6,0,12" />
              <Border Background="#120A04" CornerRadius="16" Padding="3" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="ExceptRuRouteBtn"
                          Style="{StaticResource ModeToggleButton}"
                          Content="Всё кроме РФ"
                          Click="ExceptRuRoute_Click" />
                  <Button x:Name="BlockedOnlyRouteBtn"
                          Style="{StaticResource ModeToggleButton}"
                          Content="Только блокировки"
                          Click="BlockedOnlyRoute_Click" />
                </StackPanel>
              </Border>
              <TextBlock x:Name="RoutePolicyHint"
                         Text="Иностранные сайты через VPN, российские IP — напрямую."
                         Foreground="#66FFFFFF"
                         FontSize="12"
                         TextWrapping="Wrap"
                         Margin="0,10,0,0" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource SettingsCard}">
            <StackPanel>
              <TextBlock Text="Обновление подписки" Foreground="White" FontSize="15" FontWeight="SemiBold" />
              <TextBlock x:Name="SubscriptionIntervalLabel"
                         Text="Каждые 24 часа"
                         Foreground="#99FFFFFF"
                         FontSize="13"
                         Margin="0,6,0,10" />
              <Slider x:Name="SubscriptionIntervalSlider"
                      Style="{StaticResource GoldSlider}"
                      Minimum="6"
                      Maximum="72"
                      TickFrequency="6"
                      Value="24"
                      ValueChanged="SubscriptionIntervalSlider_Changed" />
              <DockPanel Margin="0,4,0,0">
                <TextBlock Text="6 часов" Foreground="#66FFFFFF" FontSize="11" />
                <TextBlock Text="3 дня" Foreground="#66FFFFFF" FontSize="11" HorizontalAlignment="Right" />
              </DockPanel>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource SettingsCard}">
            <StackPanel>
              <TextBlock Text="Обновление списков маршрутизации" Foreground="White" FontSize="15" FontWeight="SemiBold" />
              <TextBlock Text="Удалённые списки обновляются и кешируются самим ядром без перезапуска VPN."
                         Foreground="#99FFFFFF"
                         FontSize="12"
                         TextWrapping="Wrap"
                         Margin="0,6,0,8" />
              <TextBlock x:Name="GeoIntervalLabel"
                         Text="Каждые 3 дня"
                         Foreground="#99FFFFFF"
                         FontSize="13"
                         Margin="0,0,0,10" />
              <Slider x:Name="GeoIntervalSlider"
                      Style="{StaticResource GoldSlider}"
                      Minimum="1"
                      Maximum="7"
                      TickFrequency="1"
                      Value="3"
                      ValueChanged="GeoIntervalSlider_Changed" />
              <DockPanel Margin="0,4,0,0">
                <TextBlock Text="1 день" Foreground="#66FFFFFF" FontSize="11" />
                <TextBlock Text="7 дней" Foreground="#66FFFFFF" FontSize="11" HorizontalAlignment="Right" />
              </DockPanel>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource SettingsCard}">
            <StackPanel>
              <TextBlock Text="Обновление приложения" Foreground="White" FontSize="15" FontWeight="SemiBold" />
              <TextBlock Text="Тихая проверка сайта. Если есть версия — скачивается в фоне и предлагается при открытии окна."
                         Foreground="#99FFFFFF"
                         FontSize="12"
                         TextWrapping="Wrap"
                         Margin="0,6,0,8" />
              <TextBlock x:Name="AppUpdateIntervalLabel"
                         Text="Каждые 7 дней"
                         Foreground="#99FFFFFF"
                         FontSize="13"
                         Margin="0,0,0,10" />
              <Slider x:Name="AppUpdateIntervalSlider"
                      Style="{StaticResource GoldSlider}"
                      Minimum="3"
                      Maximum="30"
                      TickFrequency="1"
                      Value="7"
                      ValueChanged="AppUpdateIntervalSlider_Changed" />
              <DockPanel Margin="0,4,0,0">
                <TextBlock Text="3 дня" Foreground="#66FFFFFF" FontSize="11" />
                <TextBlock Text="месяц" Foreground="#66FFFFFF" FontSize="11" HorizontalAlignment="Right" />
              </DockPanel>
            </StackPanel>
          </Border>

          <Button Content="Сохранить"
                  Click="SaveSettings_Click"
                  HorizontalAlignment="Stretch"
                  Padding="16,12"
                  Background="#FFB300"
                  Foreground="#1A0F08"
                  FontWeight="SemiBold"
                  Margin="0,4,0,0" />
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
  </Border>
</Window>
