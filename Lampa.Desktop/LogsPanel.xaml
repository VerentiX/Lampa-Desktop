<UserControl x:Class="Lampa.Desktop.LogsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Consolas"
             Unloaded="UserControl_Unloaded">
  <UserControl.Resources>
    <Style x:Key="TabPill" TargetType="Button">
      <Setter Property="MinWidth" Value="108" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#80FFFFFF" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="16" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                TextBlock.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Tag" Value="active">
                <Setter TargetName="Root" Property="Background" Value="#262DF578" />
                <Setter Property="Foreground" Value="#42F58A" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="GhostButton" TargetType="Button">
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Foreground" Value="#CBE8FF" />
      <Setter Property="Background" Value="#E0060D16" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="#8058B8FF" BorderThickness="1" CornerRadius="2" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#E0060D16" />
      <Setter Property="Foreground" Value="#CBE8FF" />
      <Setter Property="BorderBrush" Value="#8058B8FF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Height" Value="32" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="CaretBrush" Value="#42F58A" />
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Background="Transparent" Padding="8,6">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,8">
      <Border DockPanel.Dock="Left" Background="#B0060D16" CornerRadius="16" Padding="3">
        <StackPanel Orientation="Horizontal">
          <Button x:Name="JournalTab" Style="{StaticResource TabPill}" Tag="active" Content="Журнал" Click="JournalTab_Click" />
          <Button x:Name="AccessTab" Style="{StaticResource TabPill}" Content="Соединения" Click="AccessTab_Click" />
        </StackPanel>
      </Border>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Style="{StaticResource GhostButton}" Content="Экспорт" Click="Export_Click" Margin="0,0,6,0" />
        <Button x:Name="CloseAllBtn" Style="{StaticResource GhostButton}" Content="Закрыть всё" Click="CloseAll_Click" Visibility="Collapsed" />
      </StackPanel>
    </DockPanel>

    <TextBox x:Name="FilterBox" Grid.Row="1" Margin="0,0,0,8" TextChanged="Filter_Changed"
             ToolTip="Фильтр по хосту, цепочке или тексту лога" />

    <Grid Grid.Row="2">
      <Border x:Name="JournalPane" Background="#E00B1422" BorderBrush="#804477A7" BorderThickness="1" CornerRadius="2">
        <ListBox x:Name="JournalList"
                 Background="Transparent"
                 BorderThickness="0"
                 Foreground="#CBE8FF"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 ScrollViewer.CanContentScroll="False">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <DockPanel>
                  <TextBlock DockPanel.Dock="Left" Text="{Binding TimeText}" Foreground="#668EB5D2" FontSize="11" Margin="0,0,8,0" />
                  <TextBlock DockPanel.Dock="Left" Text="{Binding LevelText}" Foreground="{Binding LevelBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,8,0" />
                  <TextBlock Text="{Binding Message}" Foreground="{Binding MessageBrush}" FontSize="12" TextWrapping="Wrap" />
                </DockPanel>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <Border x:Name="AccessPane" Background="#E00B1422" BorderBrush="#804477A7" BorderThickness="1" CornerRadius="2" Visibility="Collapsed">
        <ListBox x:Name="ConnectionsList"
                 Background="Transparent"
                 BorderThickness="0"
                 Foreground="#CBE8FF"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 ScrollViewer.CanContentScroll="False">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="{Binding Host}" Foreground="#E8F4FF" FontSize="13" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Chain}" Foreground="#58B8FF" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                  <TextBlock Foreground="#80FFFFFF" FontSize="11" Margin="0,2,0,0">
                    <Run Text="{Binding DownText, Mode=OneWay}" />
                    <Run Text=" ↓" />
                    <Run Text="  " />
                    <Run Text="{Binding UpText, Mode=OneWay}" />
                    <Run Text=" ↑" />
                    <Run Text="  " />
                    <Run Text="{Binding DownSpeedText, Mode=OneWay}" Foreground="#42F58A" />
                  </TextBlock>
                  <TextBlock Text="{Binding Process}" Foreground="#668EB5D2" FontSize="10" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="1" Content="✕" Width="28" Height="28" FontSize="11" VerticalAlignment="Top"
                        Background="Transparent" Foreground="#80FFFFFF" BorderThickness="0"
                        Click="CloseConnection_Click" Tag="{Binding Id}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
    </Grid>

    <DockPanel Grid.Row="3" Margin="0,8,0,0">
      <TextBlock x:Name="FooterText" Text="0 строк" Foreground="#668EB5D2" FontSize="11" VerticalAlignment="Center" />
      <CheckBox x:Name="FollowTailCheck" DockPanel.Dock="Right" Content="Хвост" IsChecked="True"
                Foreground="#99FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Right" />
    </DockPanel>
  </Grid>
</UserControl>
