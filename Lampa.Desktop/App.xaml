<Application x:Class="Lampa.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="LampaGoldBrush" Color="#FFB300" />
    <SolidColorBrush x:Key="LampaGoldDimBrush" Color="#FF8F00" />
    <SolidColorBrush x:Key="LampaTextBrush" Color="#FFF4E6" />
    <SolidColorBrush x:Key="LampaMutedBrush" Color="#99FFFFFF" />
    <SolidColorBrush x:Key="LampaCardBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="LampaCardStrokeBrush" Color="#33FFFFFF" />
    <FontFamily x:Key="AppFont">Segoe UI</FontFamily>
    <Style TargetType="Window">
      <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
      <Setter Property="Foreground" Value="{StaticResource LampaTextBrush}" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#44FFB300" />
      <Setter Property="Width" Value="5" />
      <Setter Property="MinWidth" Value="5" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border Background="#44FFB300" CornerRadius="3" Margin="0,8" />
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Height" Value="5" />
          <Setter Property="MinHeight" Value="5" />
          <Setter Property="Width" Value="Auto" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <ContentPresenter />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
