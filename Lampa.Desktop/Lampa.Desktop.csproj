<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Lampa</AssemblyName>
    <RootNamespace>Lampa.Desktop</RootNamespace>
    <Version>1.0.9</Version>
    <FileVersion>1.0.9.0</FileVersion>
    <InformationalVersion>1.0.9</InformationalVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\hottabych-genie-v2.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\hottabych-genie-v2.png" />
    <Content Include="Assets\hottabych-genie-v2.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\logo.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="core\sing-box.exe" CopyToOutputDirectory="Always" Condition="Exists('core\sing-box.exe')" />
    <Content Include="core\wintun.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('core\wintun.dll')" />
    <Content Include="core\LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="core\LICENSE-wintun.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="routing\default.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="routing\except-ru.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="routing\whitelist.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
