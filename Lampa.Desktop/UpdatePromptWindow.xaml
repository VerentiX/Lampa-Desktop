<Window x:Class="Lampa.Desktop.UpdatePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Обновление Lampa"
        Width="430" Height="235"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">
  <Border Background="#101923" BorderBrush="#FFB300" BorderThickness="1" CornerRadius="16" Padding="24">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Text=":: ОБНОВЛЕНИЕ ГОТОВО ::" Foreground="#42F58A" FontSize="17" FontWeight="SemiBold" />
      <StackPanel Grid.Row="1" Margin="0,18,0,18">
        <TextBlock x:Name="VersionText" Foreground="White" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Text="Установщик уже скачан и проверен. VPN будет отключён, затем запустится обновление."
                   Foreground="#B9C9D8" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0" />
      </StackPanel>
      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Отложить" Click="Defer_Click" Padding="18,8" Margin="0,0,10,0"
                Background="#1A2835" Foreground="#CBE8FF" BorderBrush="#35506A" />
        <Button Content="Обновить" Click="Update_Click" Padding="18,8"
                Background="#FFB300" Foreground="#160D05" BorderBrush="#FFD36A" FontWeight="SemiBold" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
